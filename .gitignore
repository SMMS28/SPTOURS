# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# raw redesign source drops — already integrated into src/, kept locally only.
# Pattern (not an exact path) so re-drops like "sptours-nextjs 2" are caught too.
sptours-nextjs*
Premium redesign with animations/
export-northeast/
/public/images/Premium redesign with animations.zip

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Agent tooling — installed skills and local agent config. Not product code, and
# noise in a repo being handed to the client.
.claude/
.agents/
skills-lock.json
